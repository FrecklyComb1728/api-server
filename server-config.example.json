{
  "projectName": "API Server",
  "port": 8633,
  "staticDir": "public",
  "apiDir": "v1",
  "index": {
    "templatePath": "template/index.html"
  },
  "error": {
    "templatePath": "template/error.html"
  },
  "markdown": {
    "templatePath": "template/markdown.html"
  },
  "log": {
    "level": "debug",
    "file": true,
    "dir": "logs"
  },
  "rateLimit": {
    "enabled": true,
    "timeWindow": 60,
    "maxRequests": 100,
    "ipHeader": "X-Forwarded-For"
  },
  "cluster": {
    "enabled": true,
    "workers": 0
  },
  "redis": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 6379,
    "password": "",
    "db": 0,
    "keyPrefix": "api-server:"
  }
}
}
